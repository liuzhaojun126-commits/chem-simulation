# ============================================================
# Git 忽略清单
# ============================================================

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 生成产物（PNG/CSV 等可由脚本复现，不入库；栅格底图需入库供 ROS 导航节点加载）
viz/*.png
viz/charts/
dashboard.png
experiments/results/
experiments/*.csv

# 实验数据与日志
experiments/*.csv
*.log

# 系统文件
.DS_Store
Thumbs.db
