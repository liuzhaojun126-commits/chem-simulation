<?xml version="1.0" ?>
<!-- ============================================================
     轻量化 Tianracer AGV 模型（步骤2：差速驱动，多实例化）
     参数：轴距 L=0.32m，轮半径 r=0.05m，v_max=1.2m/s，a_max=0.8m/s²
     ============================================================ -->
<sdf version="1.6">
  <model name="agv_light">

    <!-- 基座 -->
    <link name="base_link">
      <inertial>
        <mass>15.0</mass>
        <inertia><ixx>0.4</ixx><iyy>0.4</iyy><izz>0.5</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.60 0.40 0.30</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.60 0.40 0.30</size></box></geometry>
        <material><ambient>0.1 0.4 0.6 1</ambient><diffuse>0.1 0.4 0.6 1</diffuse></material>
      </visual>
    </link>

    <!-- 左轮 -->
    <link name="left_wheel">
      <inertial>
        <mass>0.4</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
      <pose>0 0.16 0 0 0 0</pose>
    </joint>

    <!-- 右轮 -->
    <link name="right_wheel">
      <inertial>
        <mass>0.4</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
      </visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
      <pose>0 -0.16 0 0 0 0</pose>
    </joint>

    <!-- 万向轮 -->
    <link name="caster">
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
      </visual>
    </link>
    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster</child>
      <pose>-0.25 0 -0.02 0 0 0</pose>
    </joint>

    <!-- 激光雷达（360°，0.1~12m，10Hz） -->
    <link name="lidar_link">
      <pose>0.2 0 0.2 0 0 0</pose>
      <sensor name="lidar" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.1</min><max>12.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- IMU -->
    <link name="imu_link">
      <sensor name="imu" type="imu">
        <update_rate>100</update_rate>
        <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- 差速驱动 -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.6</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <update_rate>20</update_rate>
    </plugin>

  </model>
</sdf>
